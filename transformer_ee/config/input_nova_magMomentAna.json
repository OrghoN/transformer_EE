{
    "data_path": "transformer_ee/data/nova/magMomentAna/mag_moment_data.csv.xz",
    "model_phys_name": "nova_magMomentAna_nd_fhc",
    "num_workers": 10,
    "dataframe_type": "polars",
    "vector": [
        "png.dir.x",
        "png.dir.y",
        "png.dir.z",
        "png.start.x",
        "png.start.y",
        "png.start.z",
        "png.bpf[0].energy",
        "png.bpf[0].overlapE",
        "png.bpf[0].momentum.x",
        "png.bpf[0].momentum.y",
        "png.bpf[0].momentum.z",
        "png.bpf[1].energy",
        "png.bpf[1].overlapE",
        "png.bpf[1].momentum.x",
        "png.bpf[1].momentum.y",
        "png.bpf[1].momentum.z",
        "png.bpf[2].energy",
        "png.bpf[2].overlapE",
        "png.bpf[2].momentum.x",
        "png.bpf[2].momentum.y",
        "png.bpf[2].momentum.z",
        "png.len",
        "png.nhit",
        "png.nhitx",
        "png.nhity",
        "png.nplane",
        "png.calE"
    ],
    "scalar": [
        "calE",
        "remPngCalE",
        "nHit",
        "orphCalE",
        "lowGain",
        "shwCalE",
        "theta",
        "nPng",
        "shwEFrac",
        "vtxE",
        "gap"
    ],
    "target": [
        "trueLepE",
        "trueE"
    ],
    "weight": {
        "name": "FlatSpectraWeights",
        "kwargs": {
            "alpha": 0.05,
            "bins": 50,
            "range": [
                0.1,
                10
            ]
        }
    },
    "noise": {
        "name": "gaussian",
        "mean": 0,
        "std": 0.2,
        "vector": [
            "png.calE",
            "png.bpf[0].overlapE",
            "png.bpf[1].overlapE",
            "png.bpf[2].overlapE"
        ],
        "scalar": [
            "calE",
            "orphCalE",
            "remPngCalE",
            "shwCalE"
        ]
    },
    "eval_columns": [
        "passAnaPresel",
        "passAnaFull",
        "shwCalE",
        "nueRecoLepE",
        "nueRecoE",
        "isNuoneSig",
        "isNueCC",
        "isNumuCC",
        "isNC",
        "mode",
        "run",
        "subrun",
        "evt",
        "subevt"
    ],
    "max_num_prongs": 10,
    "batch_size_train": 2048,
    "batch_size_valid": 256,
    "batch_size_test": 3000,
    "test_size": 0.2,
    "valid_size": 0.04,
    "seed": 0,
    "loss": {
        "kwargs": {
            "coefficients": [
                0.5,
                0.5
            ],
            "base_loss_names": [
                "masked mean absolute percentage error",
                "mean absolute percentage error"
            ]
        }
    },
    "optimizer": {
        "name": "AdamW",
        "kwargs": {
            "lr": 0.0001
        }
    },
    "model": {
        "name": "Transformer_EE_MV",
        "epochs": 10,
        "kwargs": {
            "nhead": 9,
            "num_layers": 12,
            "d_model": 288,
            "dim_feedforward": 1152,
            "norm_first": true
        }
    },
    "save_path": "save/model/NOvA/magMomentAna/nd_fhc",
    "early_stopping": {
        "enabled": true,
        "window": 8,
        "min_delta_pct": 0.15
    }
}
